# ============================================================
# ESTEIRA DE CONTEÚDO JURÍDICO — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para a raiz da esteira como ".env" e
# preencha as chaves. O setup.sh faz a cópia automaticamente.
# NUNCA versione o arquivo .env (já está no .gitignore).
# ============================================================

# --- Scrape Creators (Agente 1 · Minerador) -----------------
# Obtida no dashboard após criar a conta em https://scrapecreators.com/
SCRAPE_CREATORS_API_KEY=

# --- KairoGen via MCP (Agente 3 · Engenheiro Audiovisual) ---
# Obtido ao autenticar o MCP em https://kairogen.ai/ pelo
# Device Flow ("Verifying Code"). Modelo usado: Nano Banana 2.
KAIROGEN_MCP_TOKEN=

# --- Zernio (Agente 4 · Social Media) -----------------------
# Gerada nas configurações da conta em https://zernio.com/
ZERNIO_API_KEY=

# ID da conta do Instagram conectada no Zernio
INSTAGRAM_ACCOUNT_ID=
