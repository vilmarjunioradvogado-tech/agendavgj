{
  "manifest_version": 3,
  "name": "PJe para Markdown",
  "version": "1.0.0",
  "description": "Seleciona um trecho de um processo aberto no PJe e converte para Markdown, pronto para colar em uma IA.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "content_scripts": [
    {
      "matches": [
        "*://*.jus.br/*"
      ],
      "js": ["converter.js", "content.js"],
      "css": ["overlay.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
