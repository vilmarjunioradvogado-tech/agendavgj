# ──────────────────────────────────────────────────────────────────────────────
# Júlia VGJ — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Claude API (obrigatório) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Modelo padrão: claude-haiku-4-5-20251001 (rápido, barato para recepcionista)
# Para mais capacidade: claude-sonnet-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Conector WhatsApp — escolha UM ───────────────────────────────────────────
# Opção A: Zappfy (recomendado para início — token simples, sem self-hosting)
WHATSAPP_PROVIDER=zappfy
ZAPPFY_TOKEN=seu_token_zappfy_aqui
ZAPPFY_INSTANCE=nome_da_instancia
ZAPPFY_BASE_URL=https://api.zappfy.io

# Opção B: Evolution API (self-hosted, sem custo por mensagem)
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=sua_api_key_evolution
# EVOLUTION_INSTANCE=julia-vgj

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000

# Token secreto que o Zappfy/Evolution envia no header X-Webhook-Secret
# Configure o mesmo valor no painel do provedor ao cadastrar o webhook
WEBHOOK_SECRET=gere_um_token_forte_aqui

# ── Número do escritório ──────────────────────────────────────────────────────
# Só para log/referência — não bloqueia nada por padrão
OFFICE_PHONE=5573XXXXXXXXX

# ── URL pública do serviço (para configurar no painel do provedor) ────────────
# Em ambiente local use ngrok: ngrok http 8000
# O Zappfy/Evolution precisa chamar essa URL via internet
# Exemplo: https://abc123.ngrok-free.app/webhook
WEBHOOK_URL=https://sua-url-publica.example.com/webhook
